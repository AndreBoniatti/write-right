@page "/profile/analysis"
@using WriteRight.Shared.Analysis
@inject WriteRightApiClient Api
@implements IDisposable

<PageTitle>WriteRight — Análise dos meus erros</PageTitle>

<div class="analysis">
    <a class="back-link" href="profile">
        <Icon Name="arrow-left" Size="16" /> Voltar ao perfil
    </a>

    <h1 class="mb-2 d-flex align-items-center gap-2">
        <Icon Name="text-search" Size="26" /> Análise dos meus erros
    </h1>
    <p class="page-lead">
        A IA lê os seus erros reais e procura a regra por trás deles. Cada padrão mostra os
        erros que o sustentam.
    </p>

    @if (loading)
    {
        <p class="text-muted">Carregando…</p>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (state is not null)
    {
        @Header(state)

        @if (state.Latest is { } latest)
        {
            @Report(latest)
        }
        else if (!generating)
        {
            <div class="empty-card">
                <Icon Name="chart" Size="22" />
                <div>
                    <strong>Nenhuma análise ainda.</strong>
                    @if (state.Gate == AnalysisGate.NotEnoughData)
                    {
                        <span> Faça mais algumas práticas e volte — com pouco histórico qualquer
                        "padrão" seria ruído com cara de conclusão.</span>
                    }
                    else
                    {
                        <span> Você já tem material suficiente. Gere a primeira acima.</span>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private AnalysisState? state;
    private bool loading = true;
    private bool generating;
    private string? error;
    private string? notice;

    /// <summary>Erros à vista em cada padrão antes do "mostrar os outros".</summary>
    private const int VisibleEvidence = 3;

    // Padrões abertos e padrões com todos os erros à vista (índice na lista). Abre só
    // o primeiro: o modelo ordena por importância, e cinco abertos viram um paredão.
    private readonly HashSet<int> openPatterns = [0];
    private readonly HashSet<int> allEvidence = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            state = await Api.GetAnalysisStateAsync();
        }
        catch (Exception ex)
        {
            error = $"Não deu pra carregar a análise. {Ui.ErrorMessage(ex)}";
        }
        finally
        {
            loading = false;
        }

        // A geração roda no servidor: se ela já estava em curso quando a página abriu
        // (recarregou, voltou depois), retoma o acompanhamento em vez de mostrar um
        // botão que o servidor vai ignorar.
        if (state?.Job.Status == AnalysisJobStatus.Running)
        {
            generating = true;

            // O Blazor só redesenha no FIM do OnInitializedAsync, que aqui dura o job
            // inteiro: sem isto a tela ficava em "Carregando…" até a primeira leitura.
            StateHasChanged();
            await FollowJobAsync();
        }
        else if (state?.Job.Status == AnalysisJobStatus.Failed)
        {
            notice = state.Job.FailureReason;
        }
    }

    // Cabeçalho: de quando é a análise, o quanto o histórico andou desde então, e a ação.
    // Análise velha (o gate já diz que vale regerar) ganha o aviso em vez de uma linha cinza.
    private RenderFragment Header(AnalysisState s) =>@<div class="head-card @(IsStale(s) ? "head-card--stale" : "")">
        <div class="head-meta">
            @if (s.Latest is { } l)
            {
                <div class="head-when">
                    @if (IsStale(s))
                    {
                        <span class="wr-badge wr-badge--warning">Desatualizada</span>
                    }
                    <span>@Generated(l.GeneratedAt)</span>
                </div>
                <p class="head-basis">
                    @Basis(l, s.NewPracticesSinceLatest)
                    @if (s.Drift is { } d)
                    {
                        @DriftText(d)
                    }
                </p>
            }
            else
            {
                <div class="head-when">Sem análise gerada.</div>
                <p class="head-basis">
                    Histórico atual: @Ui.Plural(s.CompletedPractices, "prática concluída", "práticas concluídas"),
                    @Ui.Plural(s.TotalErrors, "erro", "erros").
                </p>
            }
        </div>

        <div class="head-action">
            <button class="btn btn-primary" disabled="@(generating || s.Gate == AnalysisGate.NotEnoughData)"
                    @onclick="GenerateAsync">
                @if (generating)
                {
                    <span class="wr-spinner" aria-hidden="true"></span>
                    <span>Analisando…</span>
                }
                else
                {
                    <span>@(s.Latest is null ? "Gerar análise" : "Atualizar análise")</span>
                }
            </button>
            <div class="head-hint">@Hint(s)</div>
        </div>

        @if (notice is not null)
        {
            <div class="head-notice">@notice</div>
        }
    </div>;

    // O relatório: cada padrão na ordem em que se aprende — os seus erros, o porquê, a regra.
    private RenderFragment Report(WeaknessAnalysis a) =>@<div>
        <div class="section-head">
            <h2 class="section-title">O que está por trás dos seus erros</h2>
            <SeverityLegend />
        </div>

        <div class="pattern-list">
            @for (var i = 0; i < a.Patterns.Count; i++)
            {
                var index = i;
                var p = a.Patterns[index];
                var isOpen = openPatterns.Contains(index);
                var showAll = allEvidence.Contains(index);
                // O mais grave primeiro; dentro da mesma gravidade, o mais recente (o id da
                // prática cresce com o tempo). A ordem gravada é a em que o modelo citou.
                var evidence = p.Evidence
                    .OrderBy(e => e.Severity)
                    .ThenByDescending(e => e.PracticeId)
                    .ToList();
                var breaks = evidence.Count(e => e.Severity == ErrorSeverity.BreaksMeaning);
                var hidden = evidence.Count - VisibleEvidence;
                // Padrão de uma categoria já diz a categoria no cabeçalho; o que cruza
                // categorias precisa dizer de qual é cada erro, senão o fio entre elas some.
                var crossesCategories = p.Categories.Count > 1;
                <article class="pattern @(index == 0 ? "pattern--lead" : "")">
                    <h3 class="pattern-h">
                        <button class="pattern-head" type="button" aria-expanded="@(isOpen ? "true" : "false")"
                                aria-controls="pattern-body-@index" @onclick="() => Toggle(openPatterns, index)">
                            <span class="pattern-rank">@(index + 1)</span>
                            <span class="pattern-main">
                                <span class="pattern-title">@p.Title</span>
                                <span class="pattern-meta">
                                    @foreach (var c in p.Categories)
                                    {
                                        <span class="wr-badge wr-badge--muted">@ErrorCatalog.Info(c).LabelPt</span>
                                    }
                                    @* Um quadrado por erro citado, na cor da gravidade: o peso do padrão de relance. *@
                                    <span class="sev-strip" aria-hidden="true">
                                        @foreach (var e in evidence)
                                        {
                                            <i class="sev @Ui.SeverityFill(e.Severity)"></i>
                                        }
                                    </span>
                                    <span>
                                        @Ui.Plural(evidence.Count, "erro", "erros")@(breaks > 0
                                            ? $" · {breaks} {Ui.SeverityPhrase(ErrorSeverity.BreaksMeaning, breaks)}"
                                            : "")
                                    </span>
                                </span>
                            </span>
                            <span class="pattern-chevron @(isOpen ? "pattern-chevron--open" : "")">
                                <Icon Name="chevron-down" Size="18" />
                            </span>
                        </button>
                    </h3>

                    @* Sempre no DOM (escondido quando fechado): o aria-controls do cabeçalho
                       precisa apontar pra algo que existe. *@
                    <div class="pattern-body" id="pattern-body-@index" hidden="@(!isOpen)">
                        <div>
                            <div class="block-label">Seus erros</div>
                            <ul class="errs" id="pattern-errs-@index">
                                @foreach (var e in showAll ? evidence : evidence.Take(VisibleEvidence))
                                {
                                    <li title="@e.Explanation">
                                        <i class="sev @Ui.SeverityFill(e.Severity)" role="img"
                                           aria-label="@Ui.SeverityLabel(e.Severity)"></i>
                                        <span>
                                            <s class="text-danger">@e.Original</s>
                                            <span class="errs-arrow">→</span>
                                            <strong class="text-success">@e.Correction</strong>
                                            @if (crossesCategories)
                                            {
                                                <span class="wr-badge wr-badge--muted errs-cat">@ErrorCatalog.Info(e.Category).LabelPt</span>
                                            }
                                        </span>
                                    </li>
                                }
                            </ul>
                            @if (hidden > 0)
                            {
                                <button class="link-toggle" type="button" aria-expanded="@(showAll ? "true" : "false")"
                                        aria-controls="pattern-errs-@index" @onclick="() => Toggle(allEvidence, index)">
                                    @(showAll ? "Mostrar menos" : hidden == 1 ? "Mostrar o outro" : $"Mostrar os outros {hidden}")
                                </button>
                            }
                        </div>

                        <div>
                            <div class="block-label">Por quê</div>
                            <p class="pattern-why">@p.Diagnosis</p>
                        </div>

                        @if (p.Study is { } study)
                        {
                            <div class="rule">
                                <div class="rule-head">
                                    <span class="@KindClass(study.Kind)">@KindLabel(study.Kind)</span>
                                    <span class="rule-title">@study.Title</span>
                                </div>
                                <p class="rule-content">@study.Content</p>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <p class="analysis-foot">
            A análise lê só as linhas de erro, não os textos inteiros. Por isso ela não comenta
            tamanho de frase nem repetição de vocabulário.
        </p>
    </div>;

    private static void Toggle(HashSet<int> set, int index)
    {
        if (!set.Add(index)) set.Remove(index);
    }

    /// <summary>O gate já diz que vale regerar: é o mesmo critério, agora dito com destaque.</summary>
    private static bool IsStale(AnalysisState s) => s.Latest is not null && s.Gate == AnalysisGate.Ready;

    private static string Generated(DateTimeOffset at)
    {
        var days = (DateTime.Today - at.ToLocalTime().Date).Days;
        return days switch
        {
            // Negativo é relógio do servidor adiantado em relação ao navegador: é "hoje".
            <= 0 => "Gerada hoje",
            1 => "Gerada ontem",
            _ => $"Gerada em {Ui.ShortDate(at)}, há {days} dias",
        };
    }

    private static string Basis(WeaknessAnalysis l, int newSince) =>
        $"Ela leu {Ui.Plural(l.PracticesAnalyzed, "prática", "práticas")}" + newSince switch
        {
            0 => ".",
            1 => ", e depois veio mais 1.",
            _ => $", e depois vieram mais {newSince}.",
        };

    private static RenderFragment DriftText(AnalysisDrift d)
    {
        var read = Percent(d.CoveredShareRead);
        var since = Percent(d.CoveredShareSince);
        var items = d.TopUncoveredSince
            .Select(c => $"{ErrorCatalog.Info(c.Category).LabelPt} ({Percent(c.Share)}%)")
            .ToList();
        // "A, B e C"
        var uncovered = items.Count <= 1
            ? string.Concat(items)
            : string.Join(", ", items.Take(items.Count - 1)) + " e " + items[^1];

        return @<text>
            @if (read == since)
            {
                <span> Nesse tempo, as categorias que ela cobre seguem em <strong>@since%</strong> dos seus erros.</span>
            }
            else
            {
                <span>
                    Nesse tempo, as categorias que ela cobre @(since < read ? "caíram" : "subiram") de
                    <strong>@read%</strong> para <strong>@since%</strong> dos seus erros.
                </span>
            }
            @if (uncovered.Length > 0)
            {
                <span> As que mais aparecem agora e ela não cobre: @uncovered.</span>
            }
        </text>;
    }

    private static int Percent(double share) => (int)Math.Round(share * 100, MidpointRounding.AwayFromZero);

    /// <summary>Diz POR QUE o botão está como está, em vez de só desabilitar calado.</summary>
    private string Hint(AnalysisState s)
    {
        if (generating) return "Aguarde, isso leva alguns instantes. Se sair da página, o resultado fica salvo.";

        return s.Gate switch
        {
            AnalysisGate.NotEnoughData =>
                $"Precisa de {Ui.Plural(s.MinPractices, "prática", "práticas")} e {Ui.Plural(s.MinErrors, "erro", "erros")}. " +
                $"Você tem {s.CompletedPractices} e {s.TotalErrors}.",
            AnalysisGate.UpToDate => "Pouca coisa mudou desde a última — regerar provavelmente dirá o mesmo.",
            _ => "Leva alguns instantes.",
        };
    }

    /// <summary>De quanto em quanto tempo se pergunta ao servidor se a análise terminou.</summary>
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    /// <summary>
    /// Teto do acompanhamento. Não cancela nada no servidor — só para de perguntar,
    /// pra a tela não ficar girando pra sempre se algo der muito errado.
    /// </summary>
    private static readonly TimeSpan PollTimeout = TimeSpan.FromMinutes(10);

    /// <summary>Cancela o polling quando o usuário sai da página (o job segue no servidor).</summary>
    private readonly CancellationTokenSource cts = new();

    public void Dispose() => cts.Cancel();

    private async Task GenerateAsync()
    {
        generating = true;
        notice = null;
        error = null;

        try
        {
            var status = await Api.GenerateAnalysisAsync(cts.Token);

            if (status == GenerateAnalysisStatus.NotEnoughData)
            {
                notice = "Ainda não há histórico suficiente pra uma análise honesta.";
                generating = false;
                return;
            }

            if (status == GenerateAnalysisStatus.Failed)
            {
                notice = "A API recusou o pedido de análise. Tente de novo.";
                generating = false;
                return;
            }

            await FollowJobAsync();
        }
        catch (OperationCanceledException)
        {
            // Saiu da página; o job continua no servidor.
        }
        catch (Exception ex)
        {
            // Só o PEDIDO cai aqui: falha no acompanhamento é tratada lá dentro, e
            // dizer "falhou" com o job rodando no servidor seria mentira.
            notice = $"Falhou ao pedir a análise. {Ui.ErrorMessage(ex)}";
            generating = false;
        }
    }

    /// <summary>
    /// Acompanha a geração por polling até ela sair de <c>Running</c>.
    ///
    /// A resposta do POST não traz a análise: ela roda em background justamente pra
    /// não depender de a conexão sobreviver alguns minutos. Fechar a aba aqui não
    /// perde nada — o resultado é persistido e aparece ao voltar.
    /// </summary>
    private async Task FollowJobAsync()
    {
        var deadline = DateTimeOffset.UtcNow + PollTimeout;

        while (DateTimeOffset.UtcNow < deadline)
        {
            await Task.Delay(PollInterval, cts.Token);

            // Uma leitura que falha (rede piscando, API reiniciando) não encerra nada: o
            // job, se existir, segue no servidor. Sem isto a exceção escapava — e, vinda
            // do OnInitializedAsync, virava a barra vermelha de erro do Blazor.
            AnalysisState fresh;
            try { fresh = await Api.GetAnalysisStateAsync(cts.Token); }
            catch (Exception) when (!cts.IsCancellationRequested) { continue; }

            var previousId = state?.Latest?.Id;
            state = fresh;

            if (fresh.Job.Status == AnalysisJobStatus.Running)
            {
                StateHasChanged(); // mantém o "Analisando…" vivo
                continue;
            }

            generating = false;

            if (fresh.Job.Status == AnalysisJobStatus.Failed)
            {
                notice = fresh.Job.FailureReason;
            }
            else if (fresh.Latest?.Id != previousId)
            {
                // Análise nova: volta ao estado de abertura, só o primeiro padrão aberto.
                openPatterns.Clear();
                openPatterns.Add(0);
                allEvidence.Clear();
            }
            else
            {
                // Parado sem falha e sem análise nova: o job se perdeu. A fila é em
                // memória, então isso é a API reiniciando no meio da geração.
                notice = "A geração foi interrompida (a API reiniciou?) e nada foi salvo. Peça de novo.";
            }

            return;
        }

        generating = false;
        notice = "A análise está demorando mais que o esperado. Ela continua rodando no "
               + "servidor — recarregue a página em alguns minutos.";
    }

    private static string KindLabel(StudyItemKind kind) => kind switch
    {
        StudyItemKind.Rule => "Regra",
        _ => "Tema",
    };

    // Regra é algo que dá pra fechar hoje; tema é trabalho de longo prazo — cores diferentes.
    private static string KindClass(StudyItemKind kind) => kind switch
    {
        StudyItemKind.Rule => "wr-badge wr-badge--success",
        _ => "wr-badge wr-badge--info",
    };
}
