@page "/practice/new"
@using System.Globalization
@using System.Text.Json
@using System.Text.Json.Serialization
@inject WriteRightApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>WriteRight — Nova prática</PageTitle>

<a href="" class="small text-muted d-inline-flex align-items-center gap-1">
    <Icon Name="arrow-left" Size="16" /> Minhas práticas
</a>
<h1 class="my-3">Nova prática</h1>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="np @(loading ? "np--busy" : "")">
    <div class="np-body">
        <div class="np-field" role="group" aria-labelledby="np-level">
            <div class="np-head">
                <span id="np-level" class="np-name">Nível</span>
                <span class="np-readout"><b>@level</b> · @CefrLevels.Label(level)</span>
            </div>
            <div class="np-levels">
                @foreach (var lv in Enum.GetValues<CefrLevel>())
                {
                    <button type="button" class="np-level" aria-pressed="@(lv == level ? "true" : "false")"
                            title="@CefrLevels.Label(lv)" @onclick="() => level = lv">@lv</button>
                }
            </div>
        </div>

        <div class="np-field">
            <div class="np-head">
                <label for="np-size">Tamanho</label>
                <span class="np-readout"><b>@Sizes[sizeIndex]</b> palavras</span>
            </div>
            <div class="np-ruler" style="--np-fill: @Fill">
                <input id="np-size" type="range" min="0" max="@(Sizes.Length - 1)" step="1"
                       @bind="sizeIndex" @bind:event="oninput" aria-valuetext="@($"{Sizes[sizeIndex]} palavras")" />
                <div class="np-ticks" aria-hidden="true">
                    @for (var i = 0; i < Sizes.Length; i++)
                    {
                        <span class="@(i <= sizeIndex ? "on" : "")" style="--at: @At(i)">
                            @if (Labelled.Contains(Sizes[i]))
                            {
                                <i>@Sizes[i]</i>
                            }
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="np-field" role="group" aria-labelledby="np-theme">
            <div class="np-head">
                <span id="np-theme" class="np-name">Tema <em>· opcional</em></span>
            </div>
            <div class="np-chips">
                <button type="button" class="np-chip" aria-pressed="@(themeChoice is null ? "true" : "false")"
                        @onclick="() => themeChoice = null">Livre</button>
                @foreach (var t in Themes)
                {
                    <button type="button" class="np-chip" aria-pressed="@(themeChoice == t ? "true" : "false")"
                            @onclick="() => themeChoice = t">@t</button>
                }
                @* O campo ocupa o lugar do chip, na mesma linha, pra altura do card não mudar. *@
                @if (themeChoice == Other)
                {
                    <input @ref="otherInput" class="np-chip np-chip--input" @bind="customTheme" @bind:event="oninput"
                           placeholder="Escreva o tema" aria-label="Tema" />
                }
                else
                {
                    <button type="button" class="np-chip" aria-pressed="false" @onclick="ChooseOther">Outro…</button>
                }
            </div>
        </div>
    </div>

    @* De onde pra onde e o botão: o fim da leitura, como o resumo de um checkout. *@
    <div class="np-side">
        <div class="np-dir">
            <div class="np-route">
                <div class="np-lang">
                    <small>Traduzir de</small>
                    <strong>@Ui.LanguageName(source)</strong>
                </div>
                <div class="np-lang np-lang--to">
                    <small>para</small>
                    <strong>@Ui.LanguageName(target)</strong>
                </div>
            </div>
            <button type="button" class="np-swap @(swapped ? "np-swap--turned" : "")" @onclick="Swap"
                    title="Inverter idiomas" aria-label="Inverter idiomas">
                <Icon Name="swap" Size="18" />
            </button>
        </div>

        <button class="btn btn-primary np-cta" @onclick="Create" disabled="@loading">
            @if (loading)
            {
                <span class="wr-spinner" aria-hidden="true"></span>
                <span>Gerando texto…</span>
            }
            else
            {
                <span>Gerar texto e começar</span>
                <Icon Name="arrow-right" Size="18" />
            }
        </button>
    </div>
</div>

@code {
    /// <summary>
    /// Os entalhes da régua de tamanho. Mais juntos nos textos curtos, onde se pratica
    /// de verdade; as pontas são a régua do servidor, então a tela não tem como pedir
    /// um tamanho que ele recusaria.
    /// </summary>
    private static readonly int[] Sizes =
        [PracticeLimits.MinWords, 12, 15, 20, 25, 30, 40, 50, 60, 80, 100, 120, 150, PracticeLimits.MaxWords];

    private static readonly int[] Labelled = [PracticeLimits.MinWords, 30, 60, 100, PracticeLimits.MaxWords];

    private static readonly string[] Themes = ["Viagem", "Trabalho", "Comida", "Saúde"];

    private const string Other = "";

    /// <summary>
    /// A configuração da última prática, no navegador. A tela abre com ela marcada porque
    /// nível e tamanho quase sempre se repetem de uma prática pra outra. O tema não entra:
    /// é o que se varia.
    /// </summary>
    private const string LastKey = "wr-last-practice";

    private sealed record LastSettings(Language Source, Language Target, CefrLevel Level, int WordCount);

    /// <summary>Enum como texto, como no banco e na API: número muda de sentido se a ordem do enum mudar.</summary>
    private static readonly JsonSerializerOptions StorageJson = new() { Converters = { new JsonStringEnumConverter() } };

    private Language source = Language.Portuguese;
    private Language target = Language.English;
    private bool swapped;
    private CefrLevel level = CefrLevel.B1;
    private int sizeIndex = SizeIndexFor(60);

    /// <summary><c>null</c> = livre; <see cref="Other"/> = o campo de texto.</summary>
    private string? themeChoice;
    private string? customTheme;
    private ElementReference otherInput;
    private bool focusOther;

    private bool loading;
    private string? error;

    /// <summary>Onde o entalhe <paramref name="i"/> fica na régua (0–1), pro CSS.</summary>
    private static string At(int i) => ((double)i / (Sizes.Length - 1)).ToString("0.####", CultureInfo.InvariantCulture);

    private string Fill => At(sizeIndex);

    /// <summary>O entalhe de <paramref name="words"/> ou, se ele não existir, o mais próximo de cima.</summary>
    private static int SizeIndexFor(int words)
    {
        var i = Array.FindIndex(Sizes, s => s >= words);
        return i < 0 ? Sizes.Length - 1 : i;
    }

    private string? Theme => themeChoice == Other
        ? (string.IsNullOrWhiteSpace(customTheme) ? null : customTheme.Trim())
        : themeChoice;

    // Leitura síncrona (só existe no WASM): com await, o primeiro render sairia com o
    // padrão e trocaria pela configuração salva logo depois.
    protected override void OnInitialized()
    {
        try
        {
            var json = ((IJSInProcessRuntime)JS).Invoke<string?>("localStorage.getItem", LastKey);
            if (json is null) return;

            var last = JsonSerializer.Deserialize<LastSettings>(json, StorageJson);
            if (last is null || last.Source == last.Target
                || !Enum.IsDefined(last.Source) || !Enum.IsDefined(last.Target) || !Enum.IsDefined(last.Level))
                return;

            (source, target, level) = (last.Source, last.Target, last.Level);
            sizeIndex = SizeIndexFor(last.WordCount);
        }
        catch
        {
            // Sem localStorage ou valor ilegível: fica o padrão.
        }
    }

    private void Swap()
    {
        (source, target) = (target, source);
        swapped = !swapped;
    }

    // O campo só existe depois do render; o foco vai pra ele no OnAfterRenderAsync.
    private void ChooseOther()
    {
        themeChoice = Other;
        focusOther = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusOther) return;
        focusOther = false;
        await otherInput.FocusAsync();
    }

    private async Task Create()
    {
        loading = true;
        error = null;
        try
        {
            var req = new CreatePracticeRequest(source, target, Sizes[sizeIndex], level, Theme);
            var detail = await Api.CreatePracticeAsync(req);
            await Remember(req);
            Nav.NavigateTo($"practice/{detail.Id}");
        }
        catch (Exception ex)
        {
            // 500 aqui, com a API de pé, costuma ser a chave da Anthropic que falta.
            error = ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.InternalServerError }
                ? $"Não deu pra gerar o texto. {Ui.ErrorMessage(ex)} A chave da Anthropic foi configurada (user-secrets)?"
                : $"Não deu pra gerar o texto. {Ui.ErrorMessage(ex)}";
            loading = false;
        }
    }

    private async Task Remember(CreatePracticeRequest req)
    {
        try
        {
            var json = JsonSerializer.Serialize(
                new LastSettings(req.SourceLanguage, req.TargetLanguage, req.Level, req.WordCount), StorageJson);
            await JS.InvokeVoidAsync("localStorage.setItem", LastKey, json);
        }
        catch
        {
            // Não lembrar não impede a prática.
        }
    }
}
