@page "/cards/deck"
@inject WriteRightApiClient Api
@inject DueCardsState DueCards
@implements IDisposable

<PageTitle>WriteRight — Meu deck</PageTitle>

<div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-4">
    <div>
        <h1 class="mb-0">Meu deck</h1>
        @if (deck is { Summary.Total: > 0 })
        {
            <p class="dk-sub">@deck.Summary.Total @(deck.Summary.Total == 1 ? "card" : "cards"), todos dos seus erros</p>
        }
    </div>
    @* "Pra revisar" mora no botão: é trabalho de agora, não um estado do card — e
       se sobrepõe aos outros (card novo também está vencido). *@
    <a class="btn btn-primary" href="cards">
        Revisar
        @if (deck is { Summary.Due: > 0 })
        {
            <span class="dk-due">@deck.Summary.Due</span>
        }
    </a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (loading)
{
    <p class="text-muted">Carregando…</p>
}
else if (deck is null)
{
    <div class="alert alert-info">Nada por aqui ainda.</div>
}
else
{
    @* Os quatro estados são uma PARTIÇÃO do deck, na ordem em que um card os
       percorre: novo → aprendendo → em revisão → aprendido. Somados dão o total, e é
       isso que responde "estou progredindo?". Cada um é também o filtro da lista:
       com 50 cards, "quais estão em revisão?" é pergunta de um clique. *@
    <div class="dk-pipe" role="group" aria-label="Filtrar por estado">
        @for (var i = 0; i < Pipeline.Length; i++)
        {
            var state = Pipeline[i];
            var n = Count(state);
            if (i > 0)
            {
                <span class="dk-chev" aria-hidden="true"><Icon Name="chevron-right" Size="16" /></span>
            }
            <button type="button" class="dk-step @(n == 0 ? "dk-step--zero" : "")"
                    aria-pressed="@(filter == state ? "true" : "false")" @onclick="() => Toggle(state)">
                <b>@n</b>
                <span>@PipelineLabel(state)</span>
            </button>
        }
    </div>
    <p class="dk-note">Cada acerto leva o card um passo pra direita; errar volta ele pra aprendendo. Clique num estado pra ver só ele.</p>

    @* Os cards nascem fora da correção, então falha ali não aparece em lugar nenhum
       — a não ser aqui. Sem este aviso, uma prática sem cards seria indistinguível
       de uma prática sem nada que virasse card. *@
    @if (deck.Summary.FailedPractices > 0)
    {
        <div class="alert alert-warning d-flex align-items-center gap-3 flex-wrap">
            <span>
                <strong>Os cards de @Ui.Plural(deck.Summary.FailedPractices, "prática", "práticas") não puderam ser criados.</strong>
                Normalmente é a IA sobrecarregada.
            </span>
            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="Retry" disabled="@busy">
                Tentar de novo
            </button>
        </div>
    }
    @* Independente do aviso de falha: uma prática pode ter falhado enquanto outras
       ainda estão na fila. Some sozinho — ver OnDueCardsChanged. *@
    @if (deck.Summary.PendingPractices > 0)
    {
        <p class="text-muted small mb-3 d-flex align-items-center gap-2" role="status">
            <span class="wr-spinner" aria-hidden="true"></span>
            Preparando os cards de @Ui.Plural(deck.Summary.PendingPractices, "prática", "práticas") — eles aparecem aqui em alguns segundos.
        </p>
    }

    @if (deck.Summary.Leeches > 0)
    {
        <div class="alert alert-warning">
            <strong>@Ui.Plural(deck.Summary.Leeches, "card travado", "cards travados").</strong>
            Você já esqueceu @(deck.Summary.Leeches == 1 ? "ele" : "cada um deles") @CardScheduler.LeechLapses vezes ou
            mais — revisar de novo provavelmente não resolve. Vale descartar e reencontrar o item numa prática.
        </div>
    }

    @if (deck.Cards.Count == 0)
    {
        <div class="alert alert-info">
            Nenhum card ainda. Eles nascem sozinhos dos seus erros quando você corrige
            uma prática — só os de vocabulário (palavra, colocação, falso cognato), e só
            quando a resposta é inequívoca. Erro de gramática não vira card.
        </div>
    }
    else
    {
        var found = Filtered();
        var discarded = Count(CardState.Discarded);

        <div class="dk-tools">
            <input class="form-control" type="search" placeholder="Buscar palavra, em inglês ou português"
                   aria-label="Buscar card" autocomplete="off"
                   @bind="query" @bind:event="oninput" @bind:after="ResetPage" />
            <span class="dk-count">@CountText(found.Count)</span>
            @* Descartado não é estado da esteira: saiu dela. Fica fora da lista e do
               total, a um clique pra quem quiser conferir o que tirou. *@
            @if (discarded > 0)
            {
                <button type="button" class="wr-linkish" @onclick="() => Toggle(CardState.Discarded)">
                    @(filter == CardState.Discarded ? "Voltar pros ativos" : discarded == 1 ? "1 descartado" : $"{discarded} descartados")
                </button>
            }
        </div>

        <div class="dk-list">
            @if (found.Count == 0)
            {
                <div class="dk-empty">
                    @(!string.IsNullOrWhiteSpace(query) ? $"Nenhum card com “{query.Trim()}”."
                      : filter is null ? "Nenhum card ativo."
                      : "Nenhum card neste estado.")
                </div>
            }
            @foreach (var c in found.Take(shown))
            {
                <div class="dk-row @(c.State == CardState.Discarded ? "dk-row--out" : "")">
                    <span class="dk-when @(c.InTodaysQueue ? "dk-when--today" : "")"
                          title="@(WaitsForSibling(c) ? "Espera o outro card da mesma frase: cada frase entrega um card por dia." : null)">@When(c)</span>

                    @* A frase com a resposta no lugar da lacuna: aqui é leitura, não
                       teste, e a palavra só faz sentido dentro da frase. *@
                    <div class="dk-body">
                        <div class="dk-sentence">
                            @if (Cloze.Split(c.Prompt) is { } partes)
                            {
                                @(Lead(partes.Before))<mark>@c.Answer</mark>@(Tail(partes.After))
                            }
                            else
                            {
                                @c.Prompt
                            }
                        </div>
                        <div class="dk-meta">
                            @if (filter is null)
                            {
                                <span>@StateLabel(c.State) · </span>
                            }
                            @c.Hint · você escreveu <s>@c.YourAttempt</s>
                            @if (c.Alternatives.Count > 0)
                            {
                                <span> · também vale @string.Join(", ", c.Alternatives)</span>
                            }
                            @if (c.IsLeech && c.State != CardState.Discarded)
                            {
                                <span class="dk-leech"> · travado</span>
                            }
                        </div>
                    </div>

                    @if (c.State != CardState.Discarded)
                    {
                        <div class="dk-actions">
                            @if (discardingId == c.Id)
                            {
                                <span class="small text-muted">Descartar?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDiscard(c.Id)" disabled="@busy">Sim</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => discardingId = null" disabled="@busy">Não</button>
                            }
                            else
                            {
                                <button type="button" class="dk-del" @onclick="() => discardingId = c.Id"
                                        title="Descartar card (trecho sem resposta única, erro de digitação)" aria-label="Descartar card">
                                    <Icon Name="trash" Size="16" />
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (found.Count > shown)
        {
            var rest = found.Count - shown;
            <div class="dk-more">
                <button class="btn btn-outline-secondary" @onclick="() => shown += PageSize">
                    Mostrar mais @Math.Min(rest, PageSize) <span class="dk-rest">faltam @rest</span>
                </button>
            </div>
        }
    }
}

@code {
    /// <summary>Linhas por vez. O deck só cresce, e a lista inteira de uma vez virava
    /// uma parede a partir de umas dezenas de cards.</summary>
    private const int PageSize = 20;

    /// <summary>
    /// Quanto da frase a linha mostra de cada lado da resposta. Cortar só no fim da
    /// linha escondia a resposta das frases longas, principalmente no celular; com o
    /// recorte em volta dela, a resposta aparece em qualquer largura.
    /// </summary>
    private const int ContextChars = 50;

    /// <summary>A esteira, na ordem em que um card a percorre.</summary>
    private static readonly CardState[] Pipeline =
        [CardState.New, CardState.Learning, CardState.Review, CardState.Retired];

    private DeckView? deck;
    private bool loading = true;
    private bool busy;
    private int? discardingId;
    private string? error;

    /// <summary>Estado escolhido na esteira (ou os descartados). Null = todos os ativos.</summary>
    private CardState? filter;
    private string query = "";
    private int shown = PageSize;

    protected override Task OnInitializedAsync()
    {
        DueCards.Changed += OnDueCardsChanged;
        return Load();
    }

    public void Dispose() => DueCards.Changed -= OnDueCardsChanged;

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            await Fetch();
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Fetch()
    {
        deck = await Api.GetDeckAsync();
        // Summary.Due é a mesma fila da sessão (ver CardService.Queue), então serve
        // de fonte pro selo sem uma segunda chamada. Se ainda há cards sendo feitos,
        // o estado passa a acompanhá-los — e avisa aqui quando cada prática sair da fila.
        DueCards.Set(deck.Summary);
    }

    /// <summary>
    /// Uma prática saiu da fila de pendentes (com cards, sem nenhum, ou falhando): o
    /// deck se relê por baixo, sem o "Carregando…" do <see cref="Load"/>, que trocaria
    /// a página inteira a cada aviso.
    ///
    /// A comparação com o que está na tela é o que impede o laço: o próprio
    /// <see cref="Fetch"/> publica o resumo que acabou de receber, e ele bate. Durante
    /// <c>busy</c> não relê — a ação em andamento termina num <see cref="Load"/>.
    /// </summary>
    private void OnDueCardsChanged() => InvokeAsync(async () =>
    {
        if (deck is null || loading || busy) return;
        if (DueCards.PendingPractices == deck.Summary.PendingPractices) return;

        // Falha aqui vira aviso, como no resto da página: quando a última prática sai
        // da fila o acompanhamento já parou, então não vem outro aviso pra tentar de
        // novo — engolir o erro deixaria "Preparando…" na tela pra sempre.
        try { await Fetch(); }
        catch (Exception ex) { error = Ui.ErrorMessage(ex); }
        StateHasChanged();
    });

    private int Count(CardState state) => state switch
    {
        CardState.New => deck!.Summary.New,
        CardState.Learning => deck!.Summary.Learning,
        CardState.Review => deck!.Summary.Review,
        CardState.Retired => deck!.Summary.Retired,
        _ => deck!.Cards.Count(c => c.State == state),
    };

    private void Toggle(CardState state)
    {
        filter = filter == state ? null : state;
        ResetPage();
    }

    private void ResetPage() => shown = PageSize;

    /// <summary>
    /// Os cards do filtro e da busca, na ordem em que voltam: os da sessão de hoje
    /// primeiro, depois por data, e os que não voltam (aprendidos, descartados) por
    /// último. A busca ignora acento e maiúscula e olha a frase, a resposta, a dica e o
    /// que você escreveu — "tecnico" acha "técnico", "faucet" acha a frase.
    /// </summary>
    private List<DeckCard> Filtered()
    {
        var q = AnswerMatch.Normalize(query);
        return deck!.Cards
            .Where(c => filter is { } f ? c.State == f : c.State != CardState.Discarded)
            .Where(c => q.Length == 0
                || new[] { c.Prompt, c.Answer, c.Hint, c.YourAttempt }.Concat(c.Alternatives)
                    .Any(t => AnswerMatch.Normalize(t).Contains(q, StringComparison.Ordinal)))
            .OrderBy(c => c.State is CardState.Retired or CardState.Discarded)
            .ThenByDescending(c => c.InTodaysQueue)
            .ThenBy(c => c.DueAt ?? DateTimeOffset.MinValue) // card novo não tem data: nasce vencido
            .ThenByDescending(c => c.Id)
            .ToList();
    }

    private string CountText(int found)
    {
        var total = filter is { } f ? Count(f) : deck!.Summary.Total;
        if (!string.IsNullOrWhiteSpace(query)) return $"{found} de {total}";
        return total == 1 ? "1 card" : $"{total} cards";
    }

    /// <summary>
    /// Vencido mas fora da fila de hoje: o irmão de uma frase que já entregou um card
    /// hoje. Chamá-lo de "hoje" faria a lista prometer mais do que a sessão entrega.
    /// </summary>
    private static bool WaitsForSibling(DeckCard c) =>
        !c.InTodaysQueue
        && c.State is not (CardState.Retired or CardState.Discarded)
        && (c.DueAt is not { } due || due <= DateTimeOffset.Now); // novo: sem data, nasce vencido

    private static string When(DeckCard c)
    {
        if (c.State is CardState.Retired or CardState.Discarded) return "—";
        if (c.InTodaysQueue) return "hoje";
        if (WaitsForSibling(c)) return "em breve";

        var local = c.DueAt!.Value.ToLocalTime();
        // Vence mais tarde hoje: ainda não está na fila, então a hora, e não "hoje".
        if (local.Date == DateTime.Today) return local.ToString("HH:mm");
        return local.Date == DateTime.Today.AddDays(1) ? "amanhã" : Ui.ShortDate(c.DueAt.Value);
    }

    /// <summary>O fim do trecho antes da resposta, cortado numa palavra inteira.</summary>
    private static string Lead(string before)
    {
        if (before.Length <= ContextChars) return before;
        var cut = before[^ContextChars..];
        var space = cut.IndexOf(' ');
        return "…" + (space >= 0 ? cut[(space + 1)..] : cut);
    }

    /// <summary>O começo do trecho depois da resposta, cortado numa palavra inteira.</summary>
    private static string Tail(string after)
    {
        if (after.Length <= ContextChars) return after;
        var cut = after[..ContextChars];
        var space = cut.LastIndexOf(' ');
        return (space > 0 ? cut[..space] : cut) + "…";
    }

    private async Task ConfirmDiscard(int id)
    {
        busy = true;
        error = null;
        try
        {
            if (!await Api.DiscardCardAsync(id))
            {
                error = "Não foi possível descartar o card.";
                return;
            }

            discardingId = null;
            // Relê por baixo, sem o "Carregando…" do Load: numa lista longa, trocar a
            // página inteira jogava a rolagem pro topo a cada descarte.
            await Fetch();
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Retry()
    {
        busy = true;
        error = null;
        try
        {
            if (!await Api.RetryFailedCardsAsync())
            {
                error = "Não foi possível pedir de novo.";
                return;
            }
            await Load(); // o aviso vira "preparando"
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private static string PipelineLabel(CardState s) => s switch
    {
        CardState.New => "novos",
        CardState.Learning => "aprendendo",
        CardState.Review => "em revisão",
        CardState.Retired => "aprendidos",
        _ => s.ToString(),
    };

    /// <summary>O estado de um card só, na linha da lista sem filtro.</summary>
    private static string StateLabel(CardState s) => s switch
    {
        CardState.New => "novo",
        CardState.Learning => "aprendendo",
        CardState.Review => "em revisão",
        CardState.Retired => "aprendido",
        _ => s.ToString(),
    };
}
