@page "/profile"
@inject WriteRightApiClient Api

<PageTitle>WriteRight — Meu perfil</PageTitle>

<h1 class="mb-4 d-flex align-items-center gap-2">
    <Icon Name="chart" Size="26" /> Meu perfil de fraquezas
</h1>

@if (loading)
{
    <p class="text-muted">Carregando…</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (profile is not null)
{
    <div class="profile">
    @if (profile.Lifetime.Attempts == 0)
    {
        <div class="alert alert-info">
            Ainda não há dados. Comece uma <a href="practice/new">nova prática</a> e volte aqui pra ver
            onde você mais tropeça.
        </div>
    }
    else
    {
        var life = profile.Lifetime;
        var top = life.ByCategory.Count > 0 ? life.ByCategory[0] : null;

        <div class="stat-row">
            <div class="stat-tile">
                <div class="stat-value">@life.Attempts</div>
                <div class="stat-label">@(life.Attempts == 1 ? "prática concluída" : "práticas concluídas")</div>
            </div>
            <div class="stat-tile">
                <div class="stat-value">@life.TotalErrors</div>
                <div class="stat-label">@(life.TotalErrors == 1 ? "erro no total" : "erros no total")</div>
            </div>
            <div class="stat-tile stat-tile--focus">
                <div class="stat-value stat-value--accent">@(top is null ? "—" : ErrorCatalog.Info(top.Category).LabelPt)</div>
                <div class="stat-label">
                    prioridade de estudo
                    @if (top is not null)
                    {
                        <text> · </text><a href="practice/new">Praticar agora</a>
                    }
                </div>
            </div>
        </div>

        <EvolutionChart Timeline="profile.Timeline" />

        @Categories(life, top?.Category)

        @* Esta tela mostra O QUÊ você erra; a análise procura o PORQUÊ. Entrada
           discreta de propósito — o perfil continua sendo os números frios. *@
        <a class="analysis-cta" href="profile/analysis">
            <span class="analysis-cta-icon"><Icon Name="text-search" Size="20" /></span>
            <span class="analysis-cta-text">
                <strong>Análise dos meus erros</strong>
                <span>Os padrões por trás das categorias, com os erros que sustentam cada um.</span>
            </span>
            <span class="analysis-cta-go">Ver</span>
        </a>
    }
    </div>
}

@code {
    /// <summary>Categorias visíveis antes do "mostrar as outras" — a cauda tem 1 ou 2 erros cada.</summary>
    private const int TopCategories = 8;

    /// <summary>Erros reais que o painel mostra antes do "ver todos": "Escolha de palavra" sozinha passa de 60.</summary>
    private const int PreviewErrors = 2;

    private ErrorProfile? profile;
    private bool loading = true;
    private string? error;

    /// <summary>Histórico todo (false) ou só a janela recente (true).</summary>
    private bool recent;
    private bool allCategories;

    /// <summary>As práticas da janela recente — as últimas da linha do tempo, na mesma ordem do servidor.</summary>
    private HashSet<int> recentPracticeIds = new();

    // Revisão: quais categorias estão abertas, quais já pediram "ver todos", e o cache
    // dos erros reais por categoria (null = carregando). Carrega sob demanda, na 1ª abertura.
    private readonly HashSet<ErrorCategory> open = new();
    private readonly HashSet<ErrorCategory> showAll = new();
    private readonly Dictionary<ErrorCategory, IReadOnlyList<CategoryError>?> examples = new();

    /// <summary>Categorias cuja última leitura falhou — o painel oferece tentar de novo.</summary>
    private readonly HashSet<ErrorCategory> failed = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await Api.GetProfileAsync();
            recentPracticeIds = profile.Timeline
                .TakeLast(profile.Recent.Attempts)
                .Select(p => p.PracticeId)
                .ToHashSet();
        }
        catch (Exception ex)
        {
            error = $"Não deu pra carregar o perfil. {Ui.ErrorMessage(ex)}";
        }
        finally
        {
            loading = false;
        }
    }

    // Uma lista só, com o seletor de período no lugar da seção recente duplicada. A
    // barra é o VOLUME (Count), dividido por gravidade; a ordem é o PESO (Score) — as
    // cores mostram por que uma categoria rara mas grave passa na frente.
    private RenderFragment Categories(ProfileView life, ErrorCategory? focus) => __builder =>
    {
        // Recent só difere do histórico quando há mais práticas do que cabem na janela.
        var split = life.Attempts > profile!.Recent.Attempts;
        var scopedToRecent = split && recent;
        var view = scopedToRecent ? profile.Recent : life;
        var shown = allCategories ? view.ByCategory : view.ByCategory.Take(TopCategories).ToList();
        var max = view.ByCategory.Count == 0 ? 0 : view.ByCategory.Max(c => c.Count);
        var rest = view.ByCategory.Count - TopCategories;

        <section class="card cats-card" aria-labelledby="cats-title">
            <div class="cats-head">
                <div>
                    <h2 class="cats-title" id="cats-title">Onde você tropeça</h2>
                    @* Os pesos vêm da mesma régua que ordena: escritos à mão, mudariam só lá. *@
                    <p class="cats-sub">
                        Ordenado por peso: quebrar o sentido conta @SeverityWeight.Of(ErrorSeverity.BreaksMeaning)×,
                        compreensível @SeverityWeight.Of(ErrorSeverity.Understandable)×,
                        lapidação @SeverityWeight.Of(ErrorSeverity.Polish)×.
                        Clique numa categoria pra ver os seus erros.
                    </p>
                </div>
                @if (split)
                {
                    <div class="wr-seg" role="group" aria-label="Período">
                        <button type="button" aria-pressed="@(recent ? "false" : "true")" @onclick="() => SetPeriod(false)">Histórico todo</button>
                        <button type="button" aria-pressed="@(recent ? "true" : "false")" @onclick="() => SetPeriod(true)">Últimas @profile.Recent.Attempts</button>
                    </div>
                }
            </div>
            <div class="cats-legend"><SeverityLegend /></div>

            @if (view.ByCategory.Count == 0)
            {
                <p class="cats-empty">
                    @(scopedToRecent ? $"Nas suas últimas {view.Attempts} práticas, nenhum erro." : "Nenhum erro até agora.")
                    Segue assim.
                </p>
            }
            else
            {
                <div class="cats">
                    @foreach (var c in shown)
                    {
                        var info = ErrorCatalog.Info(c.Category);
                        var isOpen = open.Contains(c.Category);
                        <div class="cat @(isOpen ? "cat--open" : "")">
                            <button type="button" class="cat-btn" aria-expanded="@(isOpen ? "true" : "false")"
                                    @onclick="() => ToggleAsync(c.Category)">
                                <span class="cat-name">
                                    <span>@info.LabelPt</span>
                                    @if (c.Category == focus)
                                    {
                                        <span class="cat-focus">foco</span>
                                    }
                                </span>
                                <span class="cat-bar">
                                    @foreach (var s in Segments(c.BySeverity, max))
                                    {
                                        <i class="@Ui.SeverityFill(s.Severity) @(s.Last ? "cat-bar__end" : "")"
                                           style="left:@Ui.Pct(s.Left);width:@(s.Last ? Ui.Pct(s.Width) : $"calc({Ui.Pct(s.Width)} - 2px)")"
                                           title="@($"{s.Count} · {Ui.SeverityLabel(s.Severity)}")"></i>
                                    }
                                </span>
                                <span class="cat-count">@c.Count</span>
                                <span class="cat-chevron"><Icon Name="chevron-down" Size="16" /></span>
                            </button>

                            @if (isOpen)
                            {
                                @Review(c, info, scopedToRecent)
                            }
                        </div>
                    }
                </div>
                @if (rest > 0)
                {
                    <button type="button" class="cats-more" @onclick="() => allCategories = !allCategories">
                        @(allCategories ? $"Mostrar só as {TopCategories} primeiras"
                          : rest == 1 ? "Mostrar a outra categoria"
                          : $"Mostrar as outras {rest} categorias")
                    </button>
                }
            }
        </section>
    };

    // Painel da categoria: o que ela é, a divisão por gravidade (o que a barra mostra
    // só por cor) e os erros reais, os mais recentes primeiro. No período recente, só
    // os erros das práticas da janela — senão a barra dizia 5 e o painel oferecia 65.
    private RenderFragment Review(CategoryWeight c, ErrorCategoryInfo info, bool scopedToRecent) => __builder =>
    {
        <div class="review">
            <p class="review-desc">@info.Description</p>
            <p class="review-split">@Breakdown(c.BySeverity)</p>

            @if (examples.TryGetValue(c.Category, out var loaded) && loaded is not null)
            {
                var items = scopedToRecent ? loaded.Where(e => recentPracticeIds.Contains(e.PracticeId)).ToList() : loaded;
                @foreach (var it in showAll.Contains(c.Category) ? items : items.Take(PreviewErrors))
                {
                    <div class="review-item">
                        <SeverityBadge Value="it.Severity" />
                        <div class="review-diff">
                            <s class="text-danger">@it.Original</s>
                            <span class="review-arrow">→</span>
                            <strong class="text-success">@it.Correction</strong>
                        </div>
                        <div class="review-why">@it.Explanation</div>
                    </div>
                }
                @if (items.Count > PreviewErrors && !showAll.Contains(c.Category))
                {
                    <button type="button" class="wr-linkish review-all" @onclick="() => showAll.Add(c.Category)">
                        Ver todos os @items.Count erros de @info.LabelPt@(scopedToRecent ? $" nas últimas {profile!.Recent.Attempts}" : "")
                    </button>
                }
            }
            else if (failed.Contains(c.Category))
            {
                <p class="review-loading">
                    Não deu pra carregar seus erros dessa categoria.
                    <button type="button" class="wr-linkish" @onclick="() => LoadExamplesAsync(c.Category)">Tentar de novo</button>
                </p>
            }
            else
            {
                <p class="review-loading">Carregando seus erros…</p>
            }
        </div>
    };

    private void SetPeriod(bool toRecent)
    {
        recent = toRecent;
        allCategories = false;
        showAll.Clear(); // "ver todos" vale pro período em que foi pedido
    }

    // Abre/fecha a revisão de uma categoria; carrega os erros reais na 1ª abertura.
    private async Task ToggleAsync(ErrorCategory category)
    {
        if (!open.Add(category)) { open.Remove(category); return; } // já estava aberto → fecha

        if (!examples.ContainsKey(category)) await LoadExamplesAsync(category);
    }

    /// <summary>
    /// Carrega os erros reais de uma categoria. A falha fica DENTRO do painel, com o
    /// botão de tentar de novo: antes ela ia pro alerta da página, que trocava o perfil
    /// inteiro pela mensagem — e não sobrava nada na tela pra tentar outra vez.
    /// </summary>
    private async Task LoadExamplesAsync(ErrorCategory category)
    {
        failed.Remove(category);
        examples[category] = null; // "carregando" (o re-render mostra o aviso)
        try
        {
            examples[category] = await Api.GetCategoryErrorsAsync(category);
        }
        catch
        {
            examples.Remove(category);
            failed.Add(category);
        }
    }

    private sealed record Segment(ErrorSeverity Severity, int Count, double Left, double Width, bool Last);

    /// <summary>
    /// Os pedaços da barra, mais grave à esquerda, na escala da maior categoria da
    /// visão. O vão de 2px sai da largura de cada pedaço (menos o último), pra o
    /// comprimento total continuar fiel à contagem.
    /// </summary>
    private static List<Segment> Segments(SeverityCounts counts, int max)
    {
        var parts = counts.MostSevereFirst().Where(p => p.Count > 0).ToList();

        var left = 0.0;
        var segments = new List<Segment>();
        for (var i = 0; i < parts.Count; i++)
        {
            var width = max == 0 ? 0 : (double)parts[i].Count / max;
            segments.Add(new(parts[i].Severity, parts[i].Count, left, width, i == parts.Count - 1));
            left += width;
        }
        return segments;
    }

    private static string Breakdown(SeverityCounts c) =>
        string.Join(" · ", c.MostSevereFirst()
            .Where(p => p.Count > 0)
            .Select(p => $"{p.Count} {Ui.SeverityPhrase(p.Severity, p.Count)}"));
}
