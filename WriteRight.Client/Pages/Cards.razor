@page "/cards"
@inject WriteRightApiClient Api
@inject DueCardsState DueCards
@implements IDisposable

<PageTitle>WriteRight — Revisar vocabulário</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Revisar vocabulário</h1>
    <a class="btn btn-outline-secondary" href="cards/deck">Ver o deck</a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (loading)
{
    <p class="text-muted">Carregando…</p>
}
else if (Current is null && DueCards.Count > 0)
{
    @* A fila desta tela foi lida quando ela abriu, mas o selo do menu segue o
       servidor: os cards de uma correção recente chegam segundos depois, e
       descartar um card pode liberar o irmão dele pra hoje. Sem isto a tela diria
       "nada para hoje" ao lado de um selo dizendo o contrário — e clicar no menu
       não recarrega, porque é a mesma rota. *@
    <div class="alert alert-info d-flex align-items-center gap-3 flex-wrap">
        <strong>@(DueCards.Count == 1 ? "1 card pra revisar agora." : $"{DueCards.Count} cards pra revisar agora.")</strong>
        <button class="btn btn-sm btn-primary ms-auto" @onclick="Load">Revisar</button>
    </div>
}
else if (Current is null)
{
    <div class="rv-done">
        <div class="rv-done__head">
            <span class="rv-done__mark"><Icon Name="check" Size="26" /></span>
            <div>
                @if (session.Count > 0)
                {
                    <h2>Por hoje é isso</h2>
                    <p>
                        <b>@session.Count</b> @(session.Count == 1 ? "card revisado" : "cards revisados"),
                        <b>@(session.Count(r => r.Accepted))</b> de primeira.
                    </p>
                }
                else if (deckSize > 0)
                {
                    @* Distinguir "acabei por hoje" de "não tenho card nenhum": para quem tem
                       80 cards e voltou depois de terminar, a mensagem de deck vazio soaria
                       como se o deck tivesse sumido. *@
                    <h2>Nada para hoje</h2>
                    <p>Seus @deckSize cards estão em dia. O próximo lote volta conforme os intervalos.</p>
                }
                else
                {
                    <h2>Nenhum card ainda</h2>
                    <p>Eles nascem dos seus erros de vocabulário nas práticas.</p>
                }
            </div>
        </div>

        @if (session.Count > 0)
        {
            var missed = session.Where(r => !r.Accepted).ToList();
            if (missed.Count > 0)
            {
                @* Só as que você errou: os acertos já estão no número acima, e um chip por
                   card viraria uma parede numa sessão de 50. *@
                <div class="rv-done__group">
                    <small>Pra ficar de olho</small>
                    <div class="rv-done__chips">
                        @foreach (var r in missed.Take(MaxMissedShown))
                        {
                            <span class="rv-chip"><Icon Name="x" Size="14" /> @r.Answer</span>
                        }
                        @if (missed.Count > MaxMissedShown)
                        {
                            <span class="rv-chip rv-chip--more">+@(missed.Count - MaxMissedShown)</span>
                        }
                    </div>
                </div>
            }

            <div class="rv-done__group rv-done__when">
                <small>Quando voltam</small>
                <div class="rv-done__returns">
                    @foreach (var g in session.GroupBy(r => Returns(r.IntervalDays)).OrderBy(g => g.Key.Order))
                    {
                        <span><b>@g.Count()</b> @g.Key.Label</span>
                    }
                </div>
            </div>

            <div>
                <a class="btn btn-primary" href="practice/new">Nova prática</a>
            </div>
        }
    </div>
}
else
{
    <div class="rv">
        <div class="rv-progress">
            <div class="rv-bar" aria-hidden="true"><span style="width: @Progress"></span></div>
            <span class="rv-count">@(session.Count + 1) de @(session.Count + queue!.Count)</span>
            @if (Current.Lapses > 0)
            {
                <span class="wr-badge wr-badge--warning" title="Vezes que você já esqueceu este card">
                    @Ui.Plural(Current.Lapses, "esquecimento", "esquecimentos")
                </span>
            }
        </div>

        <div class="rv-body">
            @* A dica ocupa a LACUNA, em vez de ficar solta embaixo da frase: no lugar da
               lacuna a relação dispensa legenda — é isto que você traduz, aqui. Ao
               conferir, a resposta toma o lugar da dica, e a frase vira a frase certa. *@
            <p class="rv-sentence">
                @if (Cloze.Split(Current.Prompt) is { } partes)
                {
                    @partes.Before
                    @if (revealed is null)
                    {
                        <span class="rv-slot">@Current.Hint</span>
                    }
                    else
                    {
                        @* Verde só no acerto. No erro a lacuna mostra a resposta na cor do app
                           e o veredito fica na faixa: verde ali faria ler "certo" antes de
                           saber que errou. *@
                        <span class="rv-slot rv-slot--filled @SlotModifier" title="@Current.Hint">@revealed.Answer</span>
                    }
                    @partes.After
                }
                else
                {
                    @* Enunciado sem marcador não deveria existir, mas se existir
                       é melhor mostrá-lo cru do que engolir o card. *@
                    @Current.Prompt
                }
            </p>

            @if (revealed is null)
            {
                <div class="rv-answer">
                    <input class="form-control" @bind="typed" @bind:event="oninput"
                           @onkeydown="OnKeyDown" placeholder="Escreva a resposta…" aria-label="Resposta"
                           autocomplete="off" autocapitalize="off" spellcheck="false"
                           disabled="@busy" @ref="input" />

                    @* Campo vazio NÃO desabilita o botão: "não sei" é resposta legítima
                       — a mais comum numa revisão — e fechar essa porta obrigaria a
                       digitar qualquer coisa só pra destravar a tela, enchendo o log de
                       lixo no lugar de um branco honesto. O botão muda de rótulo e de
                       peso, pra dizer o que vai acontecer antes de acontecer. *@
                    <button class="btn @(HasTyped ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="Check" disabled="@busy">
                        @(HasTyped ? "Conferir" : "Não sei")
                    </button>
                </div>
            }
            else
            {
                @* A faixa ocupa o lugar do campo: o veredito vem escrito, nos quatro
                   desfechos, em vez de deduzido de cor, e os botões ficam onde a mão já
                   estava — sem rolar a página até eles. Ela recebe o foco (ver
                   OnAfterRenderAsync), mas não é botão: um Enter ali não faz nada. *@
                <div class="rv-band rv-band--@Outcome.Modifier" tabindex="-1" @ref="band">
                    <div class="rv-verdict">
                        <strong>
                            @if (Outcome.Icon is { } icone)
                            {
                                <Icon Name="@icone" Size="16" />
                            }
                            @Outcome.Text
                        </strong>

                        @if (NearUndecided)
                        {
                            @* O "quase" é decisão do usuário: só ele sabe se tropeçou na
                               tecla ou não sabia. O servidor não arbitra isso sozinho. *@
                            <span>Você escreveu <em>@typed.Trim()</em>. Foi só um deslize de digitação?</span>
                        }
                        else if (Accepted)
                        {
                            @* São respostas certas também. Sem isto, acertar com "attorney" e
                               ver "lawyer" na lacuna pareceria acerto por sorte. *@
                            @if (revealed.Alternatives.Count > 0)
                            {
                                <span>Também vale: @string.Join(", ", revealed.Alternatives)</span>
                            }

                            @* Nos dois primeiros passos o prazo é fixo. Repetir "1 dia" nos
                               dois botões faria a escolha parecer inútil — ela não é: mexe
                               no ease, que decide o tamanho dos saltos daqui pra frente. *@
                            @if (!RatingChangesTheDate)
                            {
                                <span>
                                    Volta em @Short(revealed.EasyDays) nos dois casos. Com “Fácil”, os
                                    próximos intervalos crescem mais rápido.
                                </span>
                            }
                        }
                        else if (HasTyped)
                        {
                            @* Depois de "Não sei" não há o que mostrar. Repetir o erro de origem
                               é a coincidência que o deck existe pra pegar: dizer aqui, junto do
                               que você escreveu, em vez de imprimir a mesma palavra duas vezes. *@
                            <span>
                                Você escreveu <s>@typed.Trim()</s>@(RepeatedTheOriginalMistake ? ", o mesmo erro que criou este card." : ".")
                            </span>
                        }
                    </div>

                    <div class="rv-actions">
                        @if (NearUndecided)
                        {
                            <button class="btn btn-outline-secondary" @onclick="() => Adjudicate(true)" disabled="@busy">
                                Foi deslize, acertei
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="() => Adjudicate(false)" disabled="@busy">
                                Não sabia, errei
                            </button>
                        }
                        else if (Accepted)
                        {
                            @* Os dois com o MESMO peso visual, de propósito. Destacar o
                               "Fácil" empurraria a auto-avaliação pra cima — e ela governa
                               o ease, que governa o quanto os intervalos crescem. O app
                               não pode ter opinião sobre o quanto você achou fácil. *@
                            <button class="btn btn-outline-secondary" @onclick="() => Commit(CardRating.Hard)" disabled="@busy">
                                Difícil
                                @if (RatingChangesTheDate)
                                {
                                    <span class="rv-when">@Short(revealed.HardDays)</span>
                                }
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="() => Commit(CardRating.Easy)" disabled="@busy">
                                Fácil
                                @if (RatingChangesTheDate)
                                {
                                    <span class="rv-when">@Short(revealed.EasyDays)</span>
                                }
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="() => Commit(CardRating.Again)" disabled="@busy">
                                Continuar <span class="rv-when">@Short(revealed.AgainDays)</span>
                                <Icon Name="arrow-right" Size="16" />
                            </button>
                        }
                    </div>
                </div>

                <div class="rv-foot">
                    @* A única prosa que sobrou na revisão. O "porquê" saiu daqui de
                       propósito: ele é um retrato do erro que criou o card, e numa
                       revisão você erra de outro jeito — o texto discutia uma palavra
                       que você não escreveu, e às vezes até endossava a que escreveu.
                       Aqui a sessão é de recuperação: ver a resposta e seguir. Com o
                       erro de origem repetido, a faixa já disse tudo. *@
                    @if (!RepeatedTheOriginalMistake)
                    {
                        <span>Nasceu de uma prática em que você escreveu <strong>@revealed.YourAttempt</strong>.</span>
                    }

                    @* Descartar mora AQUI, depois da revelação: é o instante em que você
                       vê a resposta e percebe que o card está errado — o momento de
                       maior sinal do deck inteiro. Antes ele só existia na tela do deck,
                       e na prática nunca foi usado (0 descartes em 95 cards). *@
                    <span class="rv-discard">
                        @if (confirmingDiscard)
                        {
                            <span>Descartar este card? Ele não volta mais.</span>
                            <button class="btn btn-sm btn-danger" @onclick="Discard" disabled="@busy">Descartar</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmingDiscard = false" disabled="@busy">Manter</button>
                        }
                        else
                        {
                            <button type="button" class="wr-linkish" @onclick="() => confirmingDiscard = true" disabled="@busy">
                                Card errado? Descartar
                            </button>
                        }
                    </span>
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Quantas palavras erradas o fim da sessão mostra antes do "+N".</summary>
    private const int MaxMissedShown = 10;

    /// <summary>Um card revisado nesta sessão: o que o fim dela resume.</summary>
    private sealed record Reviewed(string Answer, bool Accepted, double IntervalDays);

    private List<CardReviewItem>? queue;
    private CardCheckResult? revealed;
    private readonly List<Reviewed> session = new();

    /// <summary>Decisão do usuário sobre um "quase". Null enquanto ele não decidiu.</summary>
    private bool? adjudicated;

    /// <summary>Pediu pra descartar e ainda não confirmou.</summary>
    private bool confirmingDiscard;

    private string typed = "";

    /// <summary>Tamanho do deck, lido só quando a fila vem vazia — pra saber se é
    /// "acabei por hoje" ou "não tenho card nenhum".</summary>
    private int deckSize;

    private bool loading = true;
    private bool busy;
    private string? error;
    private ElementReference input;
    private ElementReference band;

    /// <summary>Último card que recebeu foco, pra não repetir a chamada a cada tecla.</summary>
    private int? focusedCardId;

    /// <summary>A resposta acabou de ser conferida: o foco vai pra faixa no próximo render.</summary>
    private bool focusBand;

    private CardReviewItem? Current => queue is { Count: > 0 } ? queue[0] : null;

    /// <summary>Quanto da sessão já foi, pra barra. Uma barra só, e não um trecho por
    /// card: com 50 na fila, seriam 50 risquinhos.</summary>
    private string Progress =>
        $"{100 * session.Count / Math.Max(1, session.Count + queue!.Count)}%";

    /// <summary>
    /// Se a revisão conta como acerto. Um "quase" só conta depois de o usuário
    /// adjudicar — antes disso não há resposta, e é por isso que os botões de
    /// fácil/difícil ainda não aparecem.
    /// </summary>
    private bool Accepted => revealed?.Verdict switch
    {
        CardVerdict.Correct => true,
        CardVerdict.NearMiss => adjudicated == true,
        _ => false,
    };

    /// <summary>Um "quase" que você ainda não disse se foi deslize ou não.</summary>
    private bool NearUndecided => revealed is { Verdict: CardVerdict.NearMiss } && adjudicated is null;

    /// <summary>
    /// O veredito da revisão: texto, cor e ícone. Fica aqui e não no markup porque
    /// são quatro desfechos e escolher entre eles é lógica, não layout. A ordem das
    /// cláusulas importa: o "quase" ainda indeciso vem primeiro porque nesse estado
    /// não existe acerto nem erro — existe uma pergunta em aberto.
    /// </summary>
    private (string Text, string Modifier, string? Icon) Outcome
    {
        get
        {
            if (NearUndecided)
                return ("Quase", "near", null);

            if (Accepted)
                return ("Você acertou", "ok", "check");

            // "Não sei" tem a mesma consequência de errar (o card volta amanhã), então
            // leva a mesma cor. Só o texto muda: quem desiste sabe que desistiu, e
            // chamar isso de erro seria trocar um fato por um julgamento.
            return HasTyped
                ? ("Você errou", "bad", "x")
                : ("Você não sabia", "bad", "x");
        }
    }

    /// <summary>A cor da resposta na lacuna: a do veredito no acerto e no "quase"
    /// indeciso; a do app no erro.</summary>
    private string SlotModifier => Outcome.Modifier switch
    {
        "ok" => "rv-slot--ok",
        "near" => "rv-slot--near",
        _ => "",
    };

    /// <summary>
    /// Se o que você acabou de escrever é o mesmo erro que gerou o card — a
    /// coincidência que o deck existe pra pegar, e que sem aviso apareceria como
    /// a mesma palavra impressa duas vezes com dois rótulos diferentes.
    /// </summary>
    private bool RepeatedTheOriginalMistake =>
        revealed is not null && !Accepted && HasTyped
        && AnswerMatch.Normalize(typed) == AnswerMatch.Normalize(revealed.YourAttempt);

    protected override Task OnInitializedAsync()
    {
        DueCards.Changed += OnDueCardsChanged;
        return Load();
    }

    public void Dispose() => DueCards.Changed -= OnDueCardsChanged;

    /// <summary>
    /// Só importa com a fila vazia, quando a tela mostra o fim da sessão. No meio
    /// dela, o próprio Commit já publica o número e re-renderiza.
    /// </summary>
    private void OnDueCardsChanged() => InvokeAsync(() =>
    {
        if (Current is null) StateHasChanged();
    });

    /// <summary>
    /// Foco na faixa logo depois de conferir, e no campo a cada card NOVO: a sessão é
    /// uma sequência de digitação, e ter que clicar entre um card e outro quebraria o ritmo.
    ///
    /// A guarda por id não é detalhe: o campo usa <c>@@bind:event="oninput"</c>, então
    /// cada tecla dispara um render — sem ela, seria uma chamada de interop JS por
    /// caractere digitado, todas para focar o que já estava focado.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Conferir tira o campo da tela, e o foco caía no <body>: pelo teclado, chegar
        // ao "Continuar" pedia Tab desde a barra lateral, e o leitor de tela não lia o
        // veredito. A faixa não é botão, então isto não escolhe nada por você — nem um
        // Enter fora de ritmo, nem Difícil/Fácil (que precisam continuar com o mesmo peso).
        if (focusBand)
        {
            focusBand = false;
            try { await band.FocusAsync(); } catch { /* elemento já saiu da tela */ }
            return;
        }

        if (Current is null || revealed is not null || busy) return;
        if (focusedCardId == Current.Id) return;

        focusedCardId = Current.Id;
        try { await input.FocusAsync(); } catch { /* elemento já saiu da tela */ }
    }

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            queue = (await Api.GetDueCardsAsync()).ToList();
            DueCards.Set(queue.Count); // a fila que acabou de chegar É o contador

            // Só quando não há nada a fazer: aí a pergunta passa a ser "o deck está
            // vazio ou eu já terminei?", e ela precisa do total pra ser respondida.
            if (queue.Count == 0 && session.Count == 0)
                deckSize = (await Api.GetDeckSummaryAsync()).Total;
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private bool HasTyped => !string.IsNullOrWhiteSpace(typed);

    /// <summary>
    /// Se fácil e difícil levam a datas diferentes. Nos dois primeiros passos não
    /// levam (são fixos), e aí mostrar o mesmo prazo nos dois botões só faria a
    /// escolha parecer sem efeito.
    /// </summary>
    private bool RatingChangesTheDate =>
        revealed is not null && Math.Abs(revealed.EasyDays - revealed.HardDays) > 0.01;

    /// <summary>
    /// Enter só vale com algo digitado. Depois de classificar um card o foco volta
    /// sozinho pro campo, então um Enter fora de ritmo marcaria o card SEGUINTE como
    /// errado antes de você ter lido a frase. Desistir tem que ser um ato deliberado
    /// — o botão "Não sei" —, nunca o resto de uma tecla apertada rápido demais.
    /// </summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || !HasTyped) return;
        await Check();
    }

    private async Task Check()
    {
        if (Current is null || busy) return;

        busy = true;
        error = null;
        try
        {
            revealed = await Api.CheckCardAsync(Current.Id, typed);
            if (revealed is null) error = "Não foi possível conferir a resposta.";
            else focusBand = true;
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private void Adjudicate(bool correct) => adjudicated = correct;

    private async Task Commit(CardRating rating)
    {
        if (Current is null || revealed is null || busy) return;

        busy = true;
        error = null;
        try
        {
            var result = await Api.ReviewCardAsync(
                Current.Id, new CardReviewRequest(typed, Accepted, rating));

            if (result is null)
            {
                error = "Não foi possível registrar a revisão.";
                return;
            }

            session.Add(new Reviewed(revealed.Answer, Accepted, result.IntervalDays));
            Advance();

            // A resposta da revisão já traz quantos sobraram — atualizar o selo aqui
            // não custa requisição nenhuma. É o caminho mais comum de o número mudar,
            // e o único em que ele DIMINUI.
            DueCards.Set(result.RemainingDue);
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// Tira o card da sessão SEM registrar revisão: um card descartado não foi
    /// "acertado" nem "errado", e contá-lo sujaria a estatística da sessão e o log.
    /// </summary>
    private async Task Discard()
    {
        if (Current is null || busy) return;

        busy = true;
        error = null;
        try
        {
            if (!await Api.DiscardCardAsync(Current.Id))
            {
                error = "Não foi possível descartar o card.";
                return;
            }

            Advance();
            // Releitura, e não "menos um": descartar libera o irmão da mesma frase,
            // e só o servidor sabe se ele entra hoje.
            await DueCards.RefreshAsync();
        }
        catch (Exception ex)
        {
            error = Ui.ErrorMessage(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private void Advance()
    {
        queue!.RemoveAt(0);
        revealed = null;
        adjudicated = null;
        confirmingDiscard = false;
        typed = "";
    }

    /// <summary>
    /// Quando um card volta, no resumo do fim da sessão. Faixas fixas, e não o número
    /// exato de dias: cada card cresce no ritmo do próprio ease, e uma sessão de 50
    /// teria uns 15 prazos diferentes numa linha.
    /// </summary>
    private static (int Order, string Label) Returns(double days) => days switch
    {
        < 2 => (0, "amanhã"),
        <= 7 => (1, "em até uma semana"),
        <= 30 => (2, "em até um mês"),
        _ => (3, "em mais de um mês"),
    };

    /// <summary>
    /// O intervalo em palavras. Os limites (60 dias, 730) não são arbitrários: eles
    /// mantêm a unidade sempre no plural, o que evita o "1 meses" que a divisão
    /// produzia — e de quebra são mais precisos, porque "32 dias" diz mais que
    /// "1 mês". A única forma singular que sobra é "1 dia", escrita à mão.
    /// </summary>
    private static string Short(double days) => days switch
    {
        < 2 => "1 dia",
        < 60 => $"{Math.Round(days)} dias",
        < 730 => $"{Math.Round(days / 30)} meses",
        _ => $"{Math.Round(days / 365, 1)} anos",
    };
}
