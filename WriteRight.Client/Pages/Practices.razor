@page "/"
@inject WriteRightApiClient Api
@inject StreakState Streak

<PageTitle>WriteRight — Minhas práticas</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Minhas práticas</h1>
    <a class="btn btn-primary" href="practice/new">
        <Icon Name="plus" Size="18" /> Nova prática
    </a>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (loading)
{
    <p class="text-muted">Carregando…</p>
}
else if (practices.Count == 0)
{
    <div class="alert alert-info">
        Nenhuma prática ainda. Clique em <strong>Nova prática</strong> pra começar!
    </div>
}
else
{
    @* Agrupar por mês é o que dá orientação numa lista longa ("isso foi em agosto"),
       e o rótulo do grupo tira o mês de cada linha. O servidor manda as em andamento
       primeiro e o resto em ordem, então os grupos saem contíguos — também entre
       páginas: o fim de agosto que chega no "Carregar mais" entra no grupo de agosto. *@
    @foreach (var group in practices.GroupBy(GroupLabel))
    {
        <section class="wr-feed">
            <h2 class="wr-feed__label">@group.Key</h2>
            <div class="wr-feed__list">
                @foreach (var p in group)
                {
                    var open = p.Status == PracticeStatus.InProgress;
                    var at = p.CreatedAt.ToLocalTime();
                    <div class="wr-row">
                        <a class="wr-row__link" href="practice/@p.Id">
                            @* No grupo do mês, o dia da semana; no "Em andamento", que
                               junta meses diferentes, o mês. *@
                            <span class="wr-row__day">
                                <span class="wr-row__day-n">@at.Day</span>
                                <span class="wr-row__day-sub">@(open ? MonthsShort[at.Month - 1] : Weekdays[(int)at.DayOfWeek])</span>
                            </span>
                            <span class="wr-row__body">
                                <span class="wr-row__preview">@p.Preview</span>
                                <span class="wr-row__meta">@Meta(p, at)</span>
                            </span>
                            @if (open)
                            {
                                <span class="wr-row__go">Continuar <Icon Name="chevron-right" Size="16" /></span>
                            }
                            else
                            {
                                <span class="wr-row__errors @(p.ErrorCount == 0 ? "wr-row__errors--clean" : "")">
                                    <span class="wr-row__errors-n">@p.ErrorCount</span>
                                    <span class="wr-row__errors-l">@(p.ErrorCount == 1 ? "erro" : "erros")</span>
                                </span>
                            }
                        </a>
                        <div class="wr-row__actions">
                            @if (deletingId == p.Id)
                            {
                                <span class="small text-muted">Excluir?</span>
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmDelete(p.Id)" disabled="@busy">Sim</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => deletingId = null" disabled="@busy">Não</button>
                            }
                            else
                            {
                                <button class="wr-row__del" @onclick="() => deletingId = p.Id"
                                        title="Excluir prática" aria-label="Excluir prática">
                                    <Icon Name="trash" Size="16" />
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (practices.Count < total)
    {
        <div class="wr-feed__more">
            <button class="btn btn-outline-secondary" @onclick="LoadMore" disabled="@loadingMore">
                @(loadingMore ? "Carregando…" : "Carregar mais")
            </button>
            <span class="text-muted small">@practices.Count de @total</span>
        </div>
    }
}

@code {
    private static readonly string[] Months =
        ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho",
         "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

    private static readonly string[] MonthsShort =
        ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];

    private static readonly string[] Weekdays = ["dom", "seg", "ter", "qua", "qui", "sex", "sáb"];

    private readonly List<PracticeSummary> practices = new();
    private int total;
    private bool loading = true;
    private bool loadingMore;
    private bool busy;
    private int? deletingId;
    private string? error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        error = null;
        try
        {
            var page = await Api.ListPracticesAsync();
            practices.Clear();
            practices.AddRange(page.Items);
            total = page.Total;
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>
    /// A próxima página começa depois das que já estão na tela. Pular pela contagem
    /// local continua certo depois de uma exclusão, porque ela sai daqui e do banco
    /// ao mesmo tempo.
    /// </summary>
    private async Task LoadMore()
    {
        loadingMore = true;
        error = null;
        try
        {
            var page = await Api.ListPracticesAsync(practices.Count);
            practices.AddRange(page.Items);
            total = page.Total;
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loadingMore = false;
        }
    }

    /// <summary>
    /// Tira a linha da tela em vez de recarregar: recarregar voltaria pra primeira
    /// página e jogaria fora o que o "Carregar mais" já trouxe.
    /// </summary>
    private async Task ConfirmDelete(int id)
    {
        busy = true;
        error = null;
        try
        {
            if (await Api.DeletePracticeAsync(id))
            {
                // Uma prática concluída é um dia da série: sem ela, o dia pode sumir.
                if (practices.Find(p => p.Id == id)?.Status == PracticeStatus.Completed)
                    _ = Streak.RefreshAsync();

                practices.RemoveAll(p => p.Id == id);
                total--;
            }
            else
            {
                error = "Não deu pra excluir a prática.";
            }
            deletingId = null;
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private static string GroupLabel(PracticeSummary p)
    {
        if (p.Status == PracticeStatus.InProgress) return "Em andamento";
        var at = p.CreatedAt.ToLocalTime();
        return $"{Months[at.Month - 1]} de {at.Year}";
    }

    private static string Meta(PracticeSummary p, DateTimeOffset at)
    {
        var parts = new List<string>
        {
            at.ToString("HH:mm"),
            $"{LangCode(p.SourceLanguage)} → {LangCode(p.TargetLanguage)}",
        };
        if (p.Level is { } level) parts.Add(level.ToString());
        if (!string.IsNullOrWhiteSpace(p.Theme)) parts.Add(p.Theme);
        return string.Join(" · ", parts);
    }

    private static string LangCode(Language l) => l switch
    {
        Language.Portuguese => "PT",
        Language.English => "EN",
        _ => l.ToString(),
    };

    private static string Friendly(Exception ex) =>
        $"Ops, algo deu errado: {ex.Message} — a API está rodando (porta 5056)?";
}
