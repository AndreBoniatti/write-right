@page "/practice/{Id:int}"
@inject WriteRightApiClient Api
@inject NavigationManager Nav

<PageTitle>WriteRight — Prática</PageTitle>

<a href="" class="small text-muted d-inline-flex align-items-center gap-1">
    <Icon Name="arrow-left" Size="16" /> Minhas práticas
</a>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (loading)
{
    <p class="text-muted mt-3">Carregando…</p>
}
else if (practice is null)
{
    <div class="alert alert-warning mt-3">Prática não encontrada.</div>
}
else
{
    <h1 class="my-3 d-flex align-items-center gap-2">
        @if (practice.Status == PracticeStatus.Completed)
        {
            <span class="wr-badge wr-badge--success"><Icon Name="check" Size="14" /> Concluída</span>
        }
        else
        {
            <span class="wr-badge wr-badge--warning"><Icon Name="clock" Size="14" /> Em andamento</span>
        }
    </h1>

    <div class="card p-3 mb-3">
        <h6 class="text-muted">Texto (@LangName(practice.SourceLanguage) → @LangName(practice.TargetLanguage))</h6>
        <p class="lead mb-0">@practice.SourceText</p>
    </div>

    @if (practice.Status == PracticeStatus.InProgress)
    {
        <textarea class="form-control mb-3" rows="6" @bind="translation" @bind:event="oninput"
                  placeholder="Escreva sua tradução aqui…"></textarea>

        <button class="btn btn-primary" @onclick="Correct"
                disabled="@(busy || string.IsNullOrWhiteSpace(translation))">
            @(correcting ? "Corrigindo…" : "Corrigir")
        </button>
        <button class="btn btn-outline-secondary ms-2" @onclick="SaveAndExit" disabled="@busy">
            @(saving ? "Salvando…" : "Salvar e sair")
        </button>
    }
    else
    {
        <div class="card p-3 mb-3">
            <h6 class="text-muted">Sua tradução</h6>
            <p class="mb-0">@practice.UserTranslation</p>
        </div>

        <div class="card p-3 mb-3 border-success">
            <h6 class="d-flex align-items-center gap-1">
                <Icon Name="check" Size="18" /> Texto corrigido
            </h6>
            <p class="lead mb-0">@practice.CorrectedText</p>
        </div>

        @if (practice.Errors.Count == 0)
        {
            @* Sem erros não há card nenhum pra listar: sem isto, a única prática em
               que o usuário acertou tudo seria a tela mais vazia do app. *@
            <div class="card p-3 mb-2 border-success" style="max-width: 720px;">
                <div class="d-flex align-items-center gap-2">
                    <Icon Name="check" Size="18" />
                    <span>Nenhum erro encontrado nesta prática.</span>
                </div>
            </div>
        }
        else
        {
            <h5 class="mb-3">@practice.Errors.Count erro(s) encontrado(s)</h5>
            @foreach (var group in ByCategory(practice.Errors))
            {
                <h6 class="wr-error-group">
                    @ErrorCatalog.Info(group.Key).LabelPt
                    <span class="wr-error-group__count">· @group.Count()</span>
                </h6>
                @foreach (var e in group)
                {
                    <div class="card p-3 mb-2" style="max-width: 720px;">
                        @* Sem o badge de categoria: o cabeçalho do grupo já a nomeia. *@
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="@SeverityClass(e.Severity)">@SeverityLabel(e.Severity)</span>
                        </div>
                        <div class="mt-2">
                            <s class="text-danger">@e.Original</s> → <strong class="text-success">@e.Correction</strong>
                        </div>
                        <div class="text-muted small mt-1">@e.Explanation</div>
                    </div>
                }
            }
        }

        <a class="btn btn-primary mt-2" href="practice/new">
            <Icon Name="plus" Size="18" /> Nova prática
        </a>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private PracticeDetail? practice;
    private string translation = "";

    private bool loading = true;
    private bool busy;         // qualquer ação em andamento
    private bool correcting;
    private bool saving;
    private string? error;

    // OnParametersSetAsync (e não OnInitialized) pra recarregar ao navegar entre práticas.
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        try
        {
            practice = await Api.GetPracticeAsync(Id);
            translation = practice?.UserTranslation ?? "";
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Correct()
    {
        busy = true;
        correcting = true;
        error = null;
        try
        {
            var updated = await Api.CorrectPracticeAsync(Id, translation);
            if (updated is null)
                error = "Não deu pra corrigir (a prática pode já estar concluída).";
            else
                practice = updated; // vira a visão readonly com a correção
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
            correcting = false;
        }
    }

    private async Task SaveAndExit()
    {
        busy = true;
        saving = true;
        error = null;
        try
        {
            if (await Api.SaveDraftAsync(Id, translation))
                Nav.NavigateTo("");
            else
                error = "Não deu pra salvar o rascunho.";
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
            saving = false;
        }
    }

    /// <summary>
    /// Agrupa os erros por categoria, do grupo de maior peso pro menor. Espalhados na
    /// ordem do texto, três erros da mesma categoria parecem três deslizes avulsos;
    /// empilhados sob um cabeçalho com a contagem, viram o padrão que são — é a tela
    /// deixando o diagnóstico à vista em vez de pedir que o usuário o monte de cabeça.
    /// A régua é o <see cref="SeverityWeight"/>, o mesmo que ordena o perfil.
    /// Dentro do grupo o GroupBy preserva a ordem original (= a ordem do texto).
    /// </summary>
    private static IEnumerable<IGrouping<ErrorCategory, WritingError>> ByCategory(
        IReadOnlyList<WritingError> errors) =>
        errors.GroupBy(e => e.Category)
              .OrderByDescending(g => g.Sum(e => SeverityWeight.Of(e.Severity)))
              .ThenByDescending(g => g.Count());

    private static string LangName(Language l) => l switch
    {
        Language.Portuguese => "Português",
        Language.English => "Inglês",
        _ => l.ToString(),
    };

    private static string SeverityLabel(ErrorSeverity s) => s switch
    {
        ErrorSeverity.BreaksMeaning => "Quebra o sentido",
        ErrorSeverity.Understandable => "Compreensível",
        ErrorSeverity.Polish => "Lapidação",
        _ => s.ToString(),
    };

    private static string SeverityClass(ErrorSeverity s) => s switch
    {
        ErrorSeverity.BreaksMeaning => "wr-badge wr-badge--danger",
        ErrorSeverity.Understandable => "wr-badge wr-badge--warning",
        ErrorSeverity.Polish => "wr-badge wr-badge--info",
        _ => "wr-badge wr-badge--muted",
    };

    private static string Friendly(Exception ex) =>
        $"Ops, algo deu errado: {ex.Message} — a API está rodando (porta 5056)?";
}
