@page "/practice/{Id:int}"
@inject WriteRightApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>WriteRight — Prática</PageTitle>

<a href="" class="small text-muted d-inline-flex align-items-center gap-1">
    <Icon Name="arrow-left" Size="16" /> Minhas práticas
</a>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

@if (loading)
{
    <p class="text-muted mt-3">Carregando…</p>
}
else if (practice is null)
{
    <div class="alert alert-warning mt-3">Prática não encontrada.</div>
}
else
{
    @* O switch mora aqui, e não junto da lista de erros, porque ele governa a página
       inteira — inclusive o card do texto corrigido, que aparece ANTES da lista. Um
       controle depois daquilo que ele afeta confunde. *@
    <div class="my-3 d-flex align-items-center gap-2 flex-wrap">
        <h1 class="mb-0">
            @if (practice.Status == PracticeStatus.Completed)
            {
                <span class="wr-badge wr-badge--success"><Icon Name="check" Size="14" /> Concluída</span>
            }
            else
            {
                <span class="wr-badge wr-badge--warning"><Icon Name="clock" Size="14" /> Em andamento</span>
            }
        </h1>

        @if (practice.Status == PracticeStatus.Completed && practice.Errors.Count > 0)
        {
            <div class="form-check form-switch mb-0 ms-auto">
                <input class="form-check-input" type="checkbox" id="wr-drill-toggle"
                       checked="@drill" @onchange="ToggleDrill" />
                <label class="form-check-label small text-muted" for="wr-drill-toggle">
                    Tentar antes de ver a correção
                </label>
            </div>
        }
    </div>

    <div class="card p-3 mb-3">
        <h6 class="text-muted">Texto (@LangName(practice.SourceLanguage) → @LangName(practice.TargetLanguage))</h6>
        <p class="lead mb-0">@practice.SourceText</p>
    </div>

    @if (practice.Status == PracticeStatus.InProgress)
    {
        <textarea class="form-control mb-3" rows="6" @bind="translation" @bind:event="oninput"
                  placeholder="Escreva sua tradução aqui…"></textarea>

        <button class="btn btn-primary" @onclick="Correct"
                disabled="@(busy || string.IsNullOrWhiteSpace(translation))">
            @(correcting ? "Corrigindo…" : "Corrigir")
        </button>
        <button class="btn btn-outline-secondary ms-2" @onclick="SaveAndExit" disabled="@busy">
            @(saving ? "Salvando…" : "Salvar e sair")
        </button>
    }
    else
    {
        <div class="card p-3 mb-3">
            <h6 class="text-muted">Sua tradução</h6>
            <p class="mb-0">@practice.UserTranslation</p>
        </div>

        <div class="card p-3 mb-3 border-success">
            <h6 class="d-flex align-items-center gap-1">
                <Icon Name="check" Size="18" /> Texto corrigido
            </h6>
            @* No modo teste este card é o maior vazamento da tela: traz TODAS as
               correções de uma vez, antes do primeiro card de erro. Colapsado (e não
               borrado) porque um parágrafo inteiro sob blur ocupa espaço à toa. *@
            @if (drill && practice.Errors.Count > 0 && !showCorrectedText)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm align-self-start mt-1"
                        @onclick="() => showCorrectedText = true">
                    Ver texto corrigido
                </button>
            }
            else
            {
                <p class="lead mb-0">@practice.CorrectedText</p>
            }
        </div>

        @if (practice.Errors.Count == 0)
        {
            @* Sem erros não há card nenhum pra listar: sem isto, a única prática em
               que o usuário acertou tudo seria a tela mais vazia do app. *@
            <div class="card p-3 mb-2 border-success" style="max-width: 720px;">
                <div class="d-flex align-items-center gap-2">
                    <Icon Name="check" Size="18" />
                    <span>Nenhum erro encontrado nesta prática.</span>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex align-items-center gap-3 mb-3">
                <h5 class="mb-0">@practice.Errors.Count erro(s) encontrado(s)</h5>

                @if (drill && revealed.Count < practice.Errors.Count)
                {
                    <button type="button" class="wr-linkish ms-auto" @onclick="RevealAll">
                        Revelar tudo
                    </button>
                }
            </div>

            @foreach (var group in ByCategory(practice.Errors))
            {
                <h6 class="wr-error-group">
                    @ErrorCatalog.Info(group.Key).LabelPt
                    <span class="wr-error-group__count">· @group.Count()</span>
                </h6>
                @foreach (var x in group)
                {
                    <div class="card p-3 mb-2" style="max-width: 720px;">
                        @* Sem o badge de categoria: o cabeçalho do grupo já a nomeia. *@
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="@SeverityClass(x.Error.Severity)">@SeverityLabel(x.Error.Severity)</span>
                        </div>

                        @* Correção E explicação escondidas juntas: a explicação é didática,
                           então quase sempre nomeia a forma correta por extenso ("o termo
                           correto é 'season'"). Esconder só a seta verde não testaria nada. *@
                        <div class="mt-2">
                            <s class="text-danger">@x.Error.Original</s>
                            <span class="@AnswerClass(x.Index)" role="@AnswerRole(x.Index)"
                                  tabindex="@AnswerTabIndex(x.Index)" title="@AnswerTitle(x.Index)"
                                  @onclick="() => Reveal(x.Index)"
                                  @onkeydown="e => RevealOnKey(e, x.Index)">
                                → <strong class="text-success">@x.Error.Correction</strong>
                            </span>
                        </div>
                        <div class="text-muted small mt-1 @AnswerClass(x.Index)"
                             role="@AnswerRole(x.Index)" tabindex="@AnswerTabIndex(x.Index)"
                             title="@AnswerTitle(x.Index)"
                             @onclick="() => Reveal(x.Index)"
                             @onkeydown="e => RevealOnKey(e, x.Index)">
                            @x.Error.Explanation
                        </div>
                    </div>
                }
            }
        }

        <a class="btn btn-primary mt-2" href="practice/new">
            <Icon Name="plus" Size="18" /> Nova prática
        </a>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private PracticeDetail? practice;
    private string translation = "";

    private bool loading = true;
    private bool busy;         // qualquer ação em andamento
    private bool correcting;
    private bool saving;
    private string? error;

    // Modo "tentar antes de ver": correção e explicação entram borradas, e o usuário
    // revela uma a uma. A preferência é global (localStorage); o que já foi revelado
    // é por prática e morre ao navegar.
    private bool drill;
    private bool showCorrectedText;
    private readonly HashSet<int> revealed = new();

    // OnParametersSetAsync (e não OnInitialized) pra recarregar ao navegar entre práticas.
    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = null;
        // Outra prática, outras respostas: o que foi revelado aqui não vale lá.
        revealed.Clear();
        showCorrectedText = false;
        try
        {
            practice = await Api.GetPracticeAsync(Id);
            translation = practice?.UserTranslation ?? "";
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            drill = await JS.InvokeAsync<bool>("writerightDrill.get");
            if (drill) StateHasChanged();
        }
        catch
        {
            // JS indisponível — segue no modo normal (tudo visível).
        }
    }

    private async Task ToggleDrill(ChangeEventArgs e)
    {
        drill = e.Value is true;
        // Sair e voltar recomeça o teste do zero: revelação antiga não vale.
        revealed.Clear();
        showCorrectedText = false;
        try
        {
            await JS.InvokeVoidAsync("writerightDrill.set", drill);
        }
        catch
        {
            // ignora falha de interop — o modo vale pra sessão atual mesmo assim
        }
    }

    private void Reveal(int index) => revealed.Add(index);

    private void RevealOnKey(KeyboardEventArgs e, int index)
    {
        if (e.Key is "Enter" or " ") Reveal(index);
    }

    private void RevealAll()
    {
        for (var i = 0; i < (practice?.Errors.Count ?? 0); i++)
            revealed.Add(i);
        showCorrectedText = true;
    }

    private bool Hidden(int index) => drill && !revealed.Contains(index);

    // Fora do modo teste estes quatro devolvem null/vazio, e o card renderiza
    // exatamente como antes — o atributo nem chega ao HTML.
    private string AnswerClass(int index) => Hidden(index) ? "wr-answer--hidden" : "";
    private string? AnswerRole(int index) => Hidden(index) ? "button" : null;
    private string? AnswerTabIndex(int index) => Hidden(index) ? "0" : null;
    private string? AnswerTitle(int index) => Hidden(index) ? "Clique para revelar" : null;

    private async Task Correct()
    {
        busy = true;
        correcting = true;
        error = null;
        try
        {
            var updated = await Api.CorrectPracticeAsync(Id, translation);
            if (updated is null)
                error = "Não deu pra corrigir (a prática pode já estar concluída).";
            else
                practice = updated; // vira a visão readonly com a correção
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
            correcting = false;
        }
    }

    private async Task SaveAndExit()
    {
        busy = true;
        saving = true;
        error = null;
        try
        {
            if (await Api.SaveDraftAsync(Id, translation))
                Nav.NavigateTo("");
            else
                error = "Não deu pra salvar o rascunho.";
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
            saving = false;
        }
    }

    /// <summary>
    /// Agrupa os erros por categoria, do grupo de maior peso pro menor. Espalhados na
    /// ordem do texto, três erros da mesma categoria parecem três deslizes avulsos;
    /// empilhados sob um cabeçalho com a contagem, viram o padrão que são — é a tela
    /// deixando o diagnóstico à vista em vez de pedir que o usuário o monte de cabeça.
    /// A régua é o <see cref="SeverityWeight"/>, o mesmo que ordena o perfil.
    /// Dentro do grupo o GroupBy preserva a ordem original (= a ordem do texto).
    /// </summary>
    private static IEnumerable<IGrouping<ErrorCategory, IndexedError>> ByCategory(
        IReadOnlyList<WritingError> errors) =>
        errors.Select((e, i) => new IndexedError(i, e))
              .GroupBy(x => x.Error.Category)
              .OrderByDescending(g => g.Sum(x => SeverityWeight.Of(x.Error.Severity)))
              .ThenByDescending(g => g.Count());

    /// <summary>
    /// O erro com sua posição na lista original. O agrupamento embaralha a ordem, mas
    /// o estado de "já revelei este" precisa de uma chave estável — e
    /// <see cref="WritingError"/> não tem id, então o índice de origem é a chave.
    /// </summary>
    private sealed record IndexedError(int Index, WritingError Error);

    private static string LangName(Language l) => l switch
    {
        Language.Portuguese => "Português",
        Language.English => "Inglês",
        _ => l.ToString(),
    };

    private static string SeverityLabel(ErrorSeverity s) => s switch
    {
        ErrorSeverity.BreaksMeaning => "Quebra o sentido",
        ErrorSeverity.Understandable => "Compreensível",
        ErrorSeverity.Polish => "Lapidação",
        _ => s.ToString(),
    };

    private static string SeverityClass(ErrorSeverity s) => s switch
    {
        ErrorSeverity.BreaksMeaning => "wr-badge wr-badge--danger",
        ErrorSeverity.Understandable => "wr-badge wr-badge--warning",
        ErrorSeverity.Polish => "wr-badge wr-badge--info",
        _ => "wr-badge wr-badge--muted",
    };

    private static string Friendly(Exception ex) =>
        $"Ops, algo deu errado: {ex.Message} — a API está rodando (porta 5056)?";
}
