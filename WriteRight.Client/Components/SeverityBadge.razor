@* A gravidade de um erro, com a mesma cara em toda tela que lista erros: a correção,
   a revisão do perfil e a evidência da análise. *@
<span class="wr-badge @Modifier">@Ui.SeverityLabel(Value)</span>

@code {
    [Parameter, EditorRequired] public ErrorSeverity Value { get; set; }

    private string Modifier => Value switch
    {
        ErrorSeverity.BreaksMeaning => "wr-badge--danger",
        ErrorSeverity.Understandable => "wr-badge--warning",
        ErrorSeverity.Polish => "wr-badge--info",
        _ => "wr-badge--muted",
    };
}
