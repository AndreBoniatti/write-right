@* Ícones SVG inline (estilo linha, self-contained). Herdam a cor via currentColor,
   então acompanham o tema e o contexto (ex.: item de menu ativo fica violeta). *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="wr-icon" aria-hidden="true">
    @switch (Name)
    {
        case "book":
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            break;
        case "chart":
            <rect x="5" y="12" width="3.4" height="8" rx="1" fill="currentColor" stroke="none" />
            <rect x="10.3" y="6" width="3.4" height="14" rx="1" fill="currentColor" stroke="none" />
            <rect x="15.6" y="14.5" width="3.4" height="5.5" rx="1" fill="currentColor" stroke="none" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="5" />
            <line x1="12" y1="1" x2="12" y2="3" />
            <line x1="12" y1="21" x2="12" y2="23" />
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
            <line x1="1" y1="12" x2="3" y2="12" />
            <line x1="21" y1="12" x2="23" y2="12" />
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            break;
        case "moon":
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            break;
        case "trash":
            <polyline points="3 6 5 6 21 6" />
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
            <line x1="10" y1="11" x2="10" y2="17" />
            <line x1="14" y1="11" x2="14" y2="17" />
            break;
        case "plus":
            <line x1="12" y1="5" x2="12" y2="19" />
            <line x1="5" y1="12" x2="19" y2="12" />
            break;
        case "arrow-left":
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
            break;
        case "check":
            <polyline points="20 6 9 17 4 12" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <polyline points="12 7 12 12 15 14" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
}
